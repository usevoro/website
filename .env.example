# Set the final production origin in Vercel, including https:// (no path).
# SITE_ORIGIN=https://your-approved-domain.example
# Enable only for the public production launch. Preview deployments remain noindex.
SITE_INDEXABLE=false

# Optional Umami Cloud analytics. Set these in Vercel's Production environment only.
# Tracking also requires VERCEL_ENV=production (provided by Vercel) and SITE_ORIGIN.
UMAMI_ENABLED=false
# Public website UUID from Umami → Websites → Edit → Tracking code; never an API key.
# UMAMI_WEBSITE_ID=
